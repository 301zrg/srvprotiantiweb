{
  "name": "neos-ts",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "@ant-design/pro-components": "^2.6.12",
    "@ant-design/pro-provider": "^2.14.7",
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^7.0.2",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-spring/shared": "^9.7.3",
    "@react-spring/web": "^9.7.3",
    "antd": "^5.8.3",
    "classnames": "^2.3.2",
    "cookies-ts": "^1.0.5",
    "eventemitter3": "^5.0.1",
    "fflate": "0.8.2",
    "fuse.js": "^7.0.0",
    "google-protobuf": "^3.21.2",
    "i18next": "^23.11.4",
    "idb-keyval": "^6.2.1",
    "lodash-es": "^4.17.21",
    "overlayscrollbars": "^2.9.1",
    "overlayscrollbars-react": "^0.5.1",
    "rdndmb-html5-to-touch": "^8.0.3",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-multi-backend": "^8.0.3",
    "react-dom": "^18.2.0",
    "react-flag-kit": "^1.1.1",
    "react-i18next": "^14.1.1",
    "react-router-dom": "^6.15.0",
    "react-use-websocket": "^4.5.0",
    "sql.js": "^1.8.0",
    "u-reset.css": "^2.0.1",
    "uuid": "^9.0.0",
    "valtio": "^1.11.2",
    "vite-plugin-svgr": "^3.2.0",
    "ygopro-deck-encode": "^1.0.14"
  },
  "scripts": {
    "dev": "node scripts/check_replay_assets.mjs && python scripts/build_environment_assets.py && vite",
    "build": "node scripts/check_replay_assets.mjs && python scripts/build_environment_assets.py && vite build && node scripts/copy_assets.mjs",
    "build:static": "node scripts/restore_environment_assets.mjs && node scripts/check_replay_assets.mjs && vite build && node scripts/copy_assets.mjs",
    "check:replay": "node scripts/check_replay_assets.mjs",
    "test:replay-runtime": "node scripts/test_replay_runtime.mjs && node scripts/test_replay_runtime.mjs native-battle-equip && node scripts/test_replay_runtime.mjs native-monk-flip && node scripts/test_replay_runtime.mjs native-confirm-search",
    "test:replay-confirm-ui": "node scripts/replay_confirmation_ui.mjs",
    "test:replay-storage": "node scripts/test_replay_storage.mjs",
    "test:replay-ui": "node scripts/replay_ui.mjs",
    "test:replay-share-ui": "node scripts/replay_share_ui.mjs",
    "test:replay-audio": "node scripts/test_replay_audio.mjs",
    "test:replay-state": "node scripts/test_replay_card_state.mjs",
    "test:replay-state-ui": "node scripts/replay_state_ui.mjs",
    "test:replay-scene": "node scripts/test_replay_scene.mjs",
    "test:replay-field-ui": "node scripts/replay_field_ui.mjs",
    "test:replay-wss": "node scripts/restore_environment_assets.mjs && python scripts/make_local_cert.py .audit-tmp/local-cert && node scripts/local_wss_integration.mjs --replays",
    "build:cloudflare": "node scripts/build_cloudflare.mjs",
    "deploy:cloudflare": "npx --yes wrangler@4.148.0 deploy",
    "build:prod": "vite build --base=https://cdn02.moecube.com:444/neos/",
    "preview": "vite preview",
    "preview:static": "node scripts/serve_dist.mjs",
    "check:wss": "node scripts/check_wss.mjs",
    "package:test": "python scripts/package_test_release.py",
    "package:bilitoy": "python scripts/package_bilitoy_release.py",
    "test:bilitoy-package": "python scripts/test_bilitoy_package.py",
    "test:bilitoy-ui": "node scripts/bilitoy_ui.mjs",
    "test:tunnel-gateway": "node scripts/test_tunnel_gateway.mjs",
    "test:windows-tunnel-scripts": "node scripts/test_windows_tunnel_scripts.mjs",
    "test:pm2-tunnel": "node scripts/test_pm2_tunnel.mjs",
    "test:tunnel-wss": "python scripts/build_environment_assets.py && python scripts/make_local_cert.py .audit-tmp/local-cert && node scripts/local_wss_integration.mjs --tunnel",
    "test:packet": "node scripts/test_packet_framer.mjs",
    "test:duel-animation": "node --experimental-transform-types scripts/test_duel_animation.mjs",
    "test:resource-recovery": "node scripts/resource_recovery_ui.mjs",
    "test:deck-import": "node --experimental-strip-types scripts/test_deck_import.mjs",
    "test:deck-import-ui": "python scripts/build_environment_assets.py && node scripts/deck_import_ui.mjs",
    "test:deck-share-ui": "node scripts/deck_share_ui.mjs",
    "test:smoke": "node scripts/smoke_ui.mjs",
    "test:mobile-ui": "python scripts/build_environment_assets.py && node scripts/mobile_ui.mjs",
    "test:duel-feedback": "python scripts/build_environment_assets.py && node scripts/duel_feedback_ui.mjs",
    "test:room-links": "python scripts/build_environment_assets.py && node scripts/room_link_ui.mjs",
    "test:room-links:local": "python scripts/build_environment_assets.py && python scripts/make_local_cert.py .audit-tmp/local-cert && node scripts/local_wss_integration.mjs --room-links",
    "test:waitroom-ui": "python scripts/build_environment_assets.py && node scripts/waitroom_ui.mjs",
    "test:mock-duel": "python scripts/build_environment_assets.py && node scripts/mock_duel_ui.mjs",
    "test:local-wss": "python scripts/build_environment_assets.py && python scripts/make_local_cert.py .audit-tmp/local-cert && node scripts/local_wss_integration.mjs",
    "test:room-languages": "node scripts/restore_environment_assets.mjs && python scripts/make_local_cert.py .audit-tmp/local-cert && node scripts/local_wss_integration.mjs --languages",
    "play:local-wss": "python scripts/build_environment_assets.py && python scripts/make_local_cert.py .audit-tmp/local-cert && node scripts/local_wss_integration.mjs --manual",
    "check:environment": "python scripts/build_environment_assets.py && python scripts/check_environment_assets.py",
    "test:environment-snapshot": "node scripts/test_environment_snapshot.mjs",
    "agent": "node agent/src/cli.ts",
    "agent:auth": "node agent/src/cli.ts auth",
    "agent:play": "node agent/src/cli.ts play",
    "agent:llm-check": "node agent/src/cli.ts llm-check",
    "agent:codex-auth-check": "node agent/src/cli.ts codex-auth-check",
    "agent:codex-harness": "node agent/src/cli.ts codex-harness",
    "agent:codex-check": "node agent/src/cli.ts llm-check --llm-provider codex --codex-harness-url http://127.0.0.1:8787/decision",
    "test:agent": "npm run test:agent:unit && npm run test:agent:blackbox",
    "test:agent:unit": "node --test \"agent/src/**/*.test.ts\"",
    "test:agent:blackbox": "node --test \"agent/blackbox/**/*.test.ts\"",
    "test:e2e": "PLAYWRIGHT_SKIP_WEB_SERVER=false playwright test",
    "test:e2e:headed": "PLAYWRIGHT_SKIP_WEB_SERVER=false playwright test --headed",
    "test:e2e:live": "PLAYWRIGHT_SKIP_WEB_SERVER=false PLAYWRIGHT_LIVE=1 sh -c 'case \"$1\" in \"\"|--*) set -- tests/e2e/live \"$@\";; esac; playwright test \"$@\"' --",
    "test:e2e:live:headed": "PLAYWRIGHT_SKIP_WEB_SERVER=false PLAYWRIGHT_LIVE=1 sh -c 'case \"$1\" in \"\"|--*) set -- tests/e2e/live \"$@\";; esac; playwright test \"$@\" --headed' --",
    "lint": "eslint --ext .ts --ext .tsx src",
    "fmt": "npx tsc && eslint --ext .ts --ext .tsx src --fix"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/google-protobuf": "^3.15.6",
    "@types/lodash-es": "^4.17.8",
    "@types/node": "^20.5.0",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@types/sql.js": "^1.4.4",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.3.0",
    "@typescript-eslint/parser": "^6.3.0",
    "@vitejs/plugin-react": "^4.0.4",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-valtio": "^0.6.2",
    "fake-indexeddb": "6.2.4",
    "prettier": "^3.0.1",
    "sass": "^1.65.1",
    "typescript": "^5.1.6",
    "vite": "^4.4.9",
    "vite-plugin-arraybuffer": "^0.0.6",
    "vite-plugin-sass-dts": "^1.3.9",
    "vite-tsconfig-paths": "^4.2.0",
    "vite-ydk-loader": "^0.0.2"
  }
}
